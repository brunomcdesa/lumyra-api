# JDK 21 (Microsoft build ou Temurin). Ajuste para o seu instalação.
JAVA_HOME=/home/alpha7/.jdks/ms-21

# Postgres local (docker-compose). Para prod, use a URL do Render.
DB_URL=jdbc:postgresql://localhost:5432/lumyra_local
DB_USER=lumyra
DB_PASSWORD=lumyra

# Redis local (docker-compose).
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: openssl rand -base64 32
JWT_SECRET=

JWT_EXPIRATION_MS=86400000
SPRING_PROFILE=local
PORT=8080
